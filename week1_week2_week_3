        "def calculate_framebuffer_size(width, height, bpp):\n",
        "    total_pixels = width * height\n",
        "    bytes_per_pixel = bpp / 8\n",
        "    memory_bytes = total_pixels * bytes_per_pixel\n",
        "    memory_mb = memory_bytes / (1024**2)\n",
        "    return memory_mb\n",
        "\n",
        "# 4K UHD 32-bit Frame Buffer Size\n",
        "mb_4k = calculate_framebuffer_size(3840, 2160, 32)\n",
        "print(f\"4K Frame Buffer Size: {mb_4k:.2f} MB\")  # Output: 31.64 MB\n",
        "\n",
        "# Bonus: 1080p 24-bit Frame Buffer Size\n",
        "mb_1080p = calculate_framebuffer_size(1920, 1080, 24)\n",
        "print(f\"1080p 24-bit Frame Buffer Size: {mb_1080p:.2f} MB\")"
      ],
